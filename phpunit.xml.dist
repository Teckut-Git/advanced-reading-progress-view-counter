<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         testdox="true">
    <testsuites>
        <testsuite name="ARPVC Tests">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist>
            <directory>.</directory>
            <exclude>
                <directory>vendor</directory>
                <directory>node_modules</directory>
                <directory>build</directory>
                <directory>tests</directory>
            </exclude>
        </whitelist>
    </filter>
    <php>
        <define name="WP_TESTS_DOMAIN" value="localhost"/>
        <define name="WP_TESTS_EMAIL" value="admin@localhost"/>
        <define name="WP_TESTS_TITLE" value="Test Blog"/>
        <define name="WP_TESTS_PHONE" value=""/>
    </php>
</phpunit>
