{
  "name": "teckut/advanced-reading-progress-view-counter",
  "description": "Advanced Reading Progress & View Counter WordPress Plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Teckut",
      "email": "teckut@example.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress advanced-reading-progress-view-counter.php",
    "lint:fix": "phpcbf --standard=WordPress advanced-reading-progress-view-counter.php",
    "phpstan": "phpstan analyse --no-progress",
    "test": "phpunit"
  }
}
